# FORGE Environment Configuration
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit .env to source control
# Add .env to your .gitignore

# ── Provider API Keys ─────────────────────────────────────────────────────────
# At least one provider must be configured.
# Ollama works with no key if running locally.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Routing Policy ────────────────────────────────────────────────────────────
# Which provider handles which task type
# Valid values: anthropic, openai, gemini, ollama, openrouter

FORGE_CODING_PROVIDER=anthropic
FORGE_REVIEW_PROVIDER=openai
FORGE_LARGE_CONTEXT_PROVIDER=gemini
FORGE_OFFLINE_PROVIDER=ollama
FORGE_DEFAULT_PROVIDER=anthropic

# Ordered failover chain (comma-separated)
FORGE_FALLBACK_CHAIN=anthropic,openai,gemini,ollama

# ── Core Settings ─────────────────────────────────────────────────────────────
FORGE_WORKSPACE=workspace
FORGE_TASK_DIR=TASKS
FORGE_LOG_DIR=logs
FORGE_MAX_AGENTS=4
FORGE_AGENT_TIMEOUT=300

# ── Persistence ───────────────────────────────────────────────────────────────
# SQLite (default — no setup required)
DATABASE_URL=sqlite:///forge_tasks.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://forge:password@localhost:5432/forge

# Redis (optional — used for checkpointing when available)
REDIS_URL=redis://localhost:6379

# ── Telemetry ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: json (structured, for log aggregators) | text (human-readable)
LOG_FORMAT=json

# OpenTelemetry collector endpoint (optional)
OTLP_ENDPOINT=http://localhost:4317

# ── Security ──────────────────────────────────────────────────────────────────
# HashiCorp Vault (optional — recommended for production)
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=

# ── API Server ────────────────────────────────────────────────────────────────
FORGE_API_HOST=0.0.0.0
FORGE_API_PORT=8080

# ── Model Selection ───────────────────────────────────────────────────────────
# Override the default model for each provider.
# Leave blank to use the provider's built-in default.
#
# Anthropic defaults:  claude-opus-4-5
# OpenAI defaults:     gpt-4o
# Gemini defaults:     gemini-1.5-pro
# Ollama defaults:     llama3.2
# OpenRouter defaults: anthropic/claude-opus-4-5

FORGE_ANTHROPIC_MODEL=claude-opus-4-5
FORGE_OPENAI_MODEL=gpt-4o
FORGE_GEMINI_MODEL=gemini-1.5-pro
FORGE_OLLAMA_MODEL=llama3.2
FORGE_OPENROUTER_MODEL=anthropic/claude-opus-4-5

# ── Gradio UI ─────────────────────────────────────────────────────────────────
FORGE_UI_PORT=7860

# ── Forge Thunderbird — Local LLM Stack ──────────────────────────────────────
# Set FORGE_LOCAL_STACK_ENABLED=true to activate the local stack.
# When enabled, Forge routes coding/planning tasks through LiteLLM → llama-swap
# → llama.cpp before falling back to cloud providers.

FORGE_LOCAL_STACK_ENABLED=false

# Paths to binaries (llama-server and llama-swap)
FORGE_LLAMA_CPP_BINARY=C:\path\to\llama-server.exe
FORGE_LLAMA_SWAP_BINARY=C:\path\to\llama-swap.exe

# Ports (defaults work for single-machine setups)
FORGE_LLAMA_SERVER_PORT=8081
FORGE_LLAMA_SWAP_PORT=8080
FORGE_LITELLM_PORT=4000
FORGE_LITELLM_URL=http://localhost:4000

# Model directories — semicolon-separated on Windows, colon-separated on Unix
# Forge scans these recursively for *.gguf files and auto-detects roles.
FORGE_MODELS_DIR=D:\models;E:\models-IMP

# Optional: explicit per-role model paths (overrides auto-detection)
# FORGE_CODING_MODEL_PATH=D:\models\coding-Qwen3-8B-Q4_K_M.gguf
# FORGE_REASONING_MODEL_PATH=E:\models-IMP\reasoning-DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf
# FORGE_VISION_MODEL_PATH=D:\models\language-Qwen3VL-8B-Instruct-Q4_K_M.gguf
# FORGE_MMPROJ_PATH=D:\models\vision-mmproj-Qwen3VL-8B-Instruct-F16.gguf

# Role aliases passed to llama-swap (change only if you rename models in YAML)
FORGE_CODING_MODEL=qwen3
FORGE_REASONING_MODEL=deepseek
FORGE_VISION_MODEL=qwen3vl

# GPU and threading (applies to all models unless overridden per-model)
FORGE_GPU_LAYERS=99
FORGE_THREADS=8

# LiteLLM optional master key (not needed for local-only operation)
# LITELLM_MASTER_KEY=sk-forge-local
